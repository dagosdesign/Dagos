# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Account verification codes (Settings -> Account). Optional: while these are not set,
# a development server shows the code in the app as a test code and sends nothing.
# E-mail (any SMTP provider):
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="user"
# SMTP_PASS="password"
# SMTP_FROM="Lexistencehub <no-reply@example.com>"
# SMS (Twilio):
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM="+10000000000"

# Help & Support: where students' messages are e-mailed (needs the SMTP settings above).
# Without it, messages are only stored in data/support.json on the server.
# SUPPORT_EMAIL="support@example.com"

# Accounts and cloud data (Supabase). See SUPABASE_SETUP.md.
# While these are not set the app runs as before: a guest on the device, no accounts.
# Public values - built into the app:
# VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# VITE_SUPABASE_ANON_KEY="eyJ..."
# Secret - server only, never in the app, never in git:
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# Optional daily limits per Premium user (defaults: chat 300, speaking 20, analysis 40, practice 60):
# AI_DAILY_CHAT="300"
# AI_DAILY_SPEAKING="20"
